# Copy this file to .env.local for local development.
# AUTH_SECRET is required by Auth.js. Use a random 32+ character value.
AUTH_SECRET=

# Optional. Uses AUTH_SECRET when omitted. Set a separate random value if rate-limit
# counter hashes should be independently rotatable.
RATE_LIMIT_SECRET=

# Google OAuth client credentials from Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional. Comma-separated admin emails for inline editing.
# If omitted, the code falls back to sansan20036@gmail.com, shuchen.peng@gmail.com, and ihearprogram@gmail.com.
AUTH_ADMIN_EMAILS=

# Required in hosted production for durable impact-milestone and inline-content storage.
# Vercel/Supabase/other Postgres providers can supply either variable.
POSTGRES_URL=
# DATABASE_URL=

# Required for administrator-managed public site images. Create a public Supabase
# Storage bucket named site-media with a 1MB per-object limit and image/webp as
# its only allowed MIME type. The service-role key is server-only; never expose it
# through a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=site-media

# Optional only for a trusted local Postgres server without TLS.
# POSTGRES_SSL=disable

# Optional. Enables admin-only automatic translation in the timeline editor.
# Keep this secret on the server; never expose it in browser JavaScript.
# OPENAI_TRANSLATION_MODEL=gpt-5.6-luna

# Optional in Auth.js v5 on Vercel, but useful if you want to force one canonical host:
# AUTH_URL=https://www.ihearus.org
