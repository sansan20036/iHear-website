# Copy this file to .env.local for local development.
# AUTH_SECRET is required by Auth.js. Use a random 32+ character value.
AUTH_SECRET=

# Optional. Uses AUTH_SECRET when omitted. Set a separate random value if rate-limit
# counter hashes should be independently rotatable.
RATE_LIMIT_SECRET=

# Academy inquiry form, server-only. A Resend key with sending access only,
# restricted to the verified sending domain; never use a NEXT_PUBLIC_ prefix.
# Missing settings return 503 EMAIL_UNAVAILABLE; the form never pretends to send.
RESEND_API_KEY=
# A sender on the Resend-verified domain, e.g. iHear Academy <academy@notify.example.org>
ACADEMY_INQUIRY_FROM=
# Optional. Defaults to ihearprogram@gmail.com; set only to send to a test inbox.
# ACADEMY_INQUIRY_TO=

# Google OAuth client credentials from Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional. Comma-separated admin emails for inline editing.
# If omitted, the code falls back to sansan20036@gmail.com, shuchen.peng@gmail.com, and ihearprogram@gmail.com.
AUTH_ADMIN_EMAILS=
AUTH_OWNER_EMAILS=sansan20036@gmail.com,shuchen.peng@gmail.com,ihearprogram@gmail.com

# Required in hosted production for durable impact-milestone and inline-content storage.
# Vercel/Supabase/other Postgres providers can supply either variable.
POSTGRES_URL=
# DATABASE_URL=

# Required for administrator-managed site images. Create a private Supabase
# Storage bucket named site-media with a 1MB per-object limit and image/webp as
# its only allowed MIME type. The service-role key is server-only; never expose it
# through a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=site-media

# Optional only for a trusted local Postgres server without TLS.
# POSTGRES_SSL=disable

# Optional. Enables server-only English -> Traditional Chinese translation.
# Simplified Chinese is generated locally with OpenCC after the Google result.
GOOGLE_CLOUD_PROJECT_ID=

# Vercel production: use OIDC + Google Workload Identity Federation. These
# identifiers are not secrets. Vercel supplies its short-lived OIDC token at
# runtime; do not set GOOGLE_CLOUD_PRIVATE_KEY in any Vercel environment.
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_CLOUD_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CLOUD_WORKLOAD_IDENTITY_POOL_ID=vercel
GOOGLE_CLOUD_WORKLOAD_IDENTITY_PROVIDER_ID=vercel

# Local development only. Set by `npm run translation:configure -- --login`
# after gcloud creates short-lived, impersonated Application Default Credentials.
# The application intentionally refuses long-lived service-account private keys.
GOOGLE_CLOUD_LOCAL_ADC=

# Generate a different random secret for each hosted environment. This remains
# server-only and must never use a NEXT_PUBLIC_ prefix.
TRANSLATION_RECEIPT_SECRET=

# Optional in Auth.js v5 on Vercel, but useful if you want to force one canonical host:
# AUTH_URL=https://www.ihearus.org

# Online classroom (P3) and recording filing (P1). Not used on the hosted site until the
# classroom release is approved (migration 028/029, H8, M-1..M-8). Leave CLASSROOM_PROVIDER
# empty and the classroom stays closed. Never put a value of these in the repository.
# CLASSROOM_PROVIDER=zoom-video-sdk | synthetic (local tests only)
CLASSROOM_PROVIDER=
# Zoom Video SDK (the account holder creates these; see tools/classroom-acceptance/README.md).
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=
ZOOM_VIDEO_SDK_API_KEY=
ZOOM_VIDEO_SDK_API_SECRET=
ZOOM_VIDEO_SDK_WEBHOOK_SECRET=
# Tutors' pages report Zoom's session id; "verify" checks it with Zoom before it is used.
CLASSROOM_SESSION_REPORTS=verify
# Consent and staff-notice versions in force (decided by iHear; recording waits for them).
CLASSROOM_CONSENT_VERSION=
CLASSROOM_STAFF_NOTICE_VERSION=
# Multi-room blocks: recording stays off ("Classroom Only") unless this is "on" AND an owner
# switches a block to Classroom + Recording.
CLASSROOM_MULTI_RECORDING=off
# Drive filing: google | local. The parent folder's id and the domains it may be shared with
# come from configuration only. Deleting Zoom's copy after filing stays off.
CLASSROOM_DRIVE=
CLASSROOM_DRIVE_PARENT_FOLDER_ID=
CLASSROOM_DRIVE_ALLOWED_DOMAINS=
CLASSROOM_VENDOR_DELETION=off
# The approved production Drive grant (drive.file only): set CLASSROOM_DRIVE_GRANT=production and
# the folder owner's OAuth client and refresh token, as encrypted hosting settings, never in a file
# of the repository. Without CLASSROOM_DRIVE_GRANT=production a hosted site never files to Drive.
CLASSROOM_DRIVE_GRANT=
CLASSROOM_GOOGLE_CLIENT_ID=
CLASSROOM_GOOGLE_CLIENT_SECRET=
CLASSROOM_GOOGLE_REFRESH_TOKEN=
# The scheduled tick (/api/classroom/scheduled-tick) answers only "Authorization: Bearer <CRON_SECRET>";
# at least 32 random characters; without it the tick does nothing.
CRON_SECRET=
