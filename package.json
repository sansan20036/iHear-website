{
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "npm run optimize:assets && node scripts/prepare-public.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:api && npm run test:operations && npm run test:e2e",
    "test:api": "vitest run tests/image-intake.test.mjs tests/text-language-guard.test.mjs tests/translation-core.test.mjs tests/translation-api.test.mjs tests/api-routes.test.mjs tests/team-api.test.mjs tests/team-sort.test.mjs tests/admin-console-api.test.mjs tests/rate-limit.test.mjs tests/site-media-api.test.mjs tests/site-media-image.test.mjs tests/site-theme-api.test.mjs tests/site-layout-api.test.mjs",
    "test:operations": "vitest run tests/operations-config.test.mjs",
    "test:e2e": "node scripts/prepare-public.mjs && playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "serve:legacy": "node scripts/prepare-public.mjs && node server.js",
    "db:audit": "node scripts/audit-database.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "site:snapshot-production": "node scripts/snapshot-production-site.mjs",
    "db:verify-backup-file": "node scripts/verify-backup-file.mjs",
    "db:verify-preserve-legacy": "node scripts/verify-preserve-legacy-content.mjs",
    "db:verify-production-preservation": "node scripts/verify-production-preservation.mjs",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:verify-rate-limit": "node scripts/verify-rate-limit.mjs",
    "db:migrate-content": "node scripts/migrate-content-overrides.mjs",
    "db:check-content": "npm run content:check && node scripts/check-content-db.mjs",
    "db:verify-backup": "node scripts/verify-backup.mjs",
    "storage:configure-site-media": "node scripts/configure-site-media-storage.mjs",
    "optimize:assets": "node scripts/optimize-static-images.mjs",
    "content:generate": "node scripts/generate-content-slots.mjs --write",
    "content:check": "node scripts/generate-content-slots.mjs",
    "translation:configure": "node scripts/configure-google-translation.mjs",
    "translation:backfill-team-local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/backfill-local-team-translations.mjs"
  },
  "dependencies": {
    "@google-cloud/translate": "^10.0.1",
    "@supabase/supabase-js": "^2.112.3",
    "browser-image-compression": "2.0.2",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "opencc-js": "^1.4.2",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
