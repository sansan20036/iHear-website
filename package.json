{
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "npm run optimize:assets && node scripts/prepare-public.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:api && npm run test:operations && npm run test:academy && npm run test:calendar && npm run test:classroom && npm run test:recording-pathway && npm run test:e2e",
    "test:api": "vitest run tests/team-public.test.mjs tests/image-intake.test.mjs tests/text-language-guard.test.mjs tests/translation-core.test.mjs tests/translation-api.test.mjs tests/api-routes.test.mjs tests/team-api.test.mjs tests/team-sort.test.mjs tests/team-store-postgres.test.mjs tests/team-visibility-store.test.mjs tests/admin-console-api.test.mjs tests/rate-limit.test.mjs tests/site-media-api.test.mjs tests/site-media-image.test.mjs tests/site-theme-api.test.mjs tests/site-layout-api.test.mjs tests/media-galleries.test.mjs tests/resources-api.test.mjs tests/resource-topic-model.test.mjs tests/resource-topic-api.test.mjs tests/academy-inquiry.test.mjs",
    "test:operations": "vitest run tests/operations-config.test.mjs tests/production-safety.test.mjs",
    "test:e2e": "node scripts/prepare-public.mjs && playwright test",
    "test:production": "playwright test --config=playwright.production.config.mjs",
    "test:production:report": "playwright show-report output/playwright-production/report",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:public-pages && npm run test:academy-inquiry && npm run test:media-admin && npm run test:resources-admin && npm run test:team-visibility && npm run test:academy:browser",
    "test:public-pages": "node tests/public-pages.smoke.mjs",
    "test:academy-inquiry": "node tests/academy-inquiry.smoke.mjs",
    "test:academy": "vitest run tests/academy-content-model.test.mjs tests/academy-content-page.test.mjs tests/academy-content-api.test.mjs tests/academy-content-local-store.test.mjs tests/academy-content-operations.test.mjs",
    "test:academy:postgres": "vitest run tests/academy-content-postgres.test.mjs",
    "test:audit:postgres": "vitest run tests/database-audit-postgres.test.mjs",
    "test:academy:browser": "node tests/academy-cms.smoke.mjs && node tests/academy-inline.smoke.mjs",
    "test:classroom": "vitest run tests/classroom-admin-rate-limit.test.mjs tests/classroom-api.test.mjs tests/classroom-store.test.mjs tests/classroom-media.test.mjs tests/classroom-vendors.test.mjs tests/classroom-site-entry.test.mjs tests/classroom-auth-boundary.test.mjs tests/classroom-drive-google.test.mjs tests/classroom-recording-test.test.mjs tests/classroom-emergency-stop.test.mjs tests/classroom-cancel-stop.test.mjs tests/p0-session-id.sim.test.mjs tests/p1p3-integration.e2e.test.mjs tests/room-move-recording.e2e.test.mjs tests/room-consent.e2e.test.mjs tests/recording-operations.test.mjs tests/classroom-multi.test.mjs tests/classroom-multi-filing.test.mjs tests/classroom-schedule-import.test.mjs tests/classroom-schedule-routes.test.mjs",
    "test:classroom:postgres": "vitest run tests/classroom-postgres.test.mjs",
    "test:classroom:auth-postgres": "vitest run tests/classroom-auth-postgres.test.mjs",
    "test:classroom:rate-limit-postgres": "vitest run tests/classroom-admin-rate-limit-postgres.test.mjs",
    "test:classroom:multi-postgres": "vitest run tests/classroom-multi-postgres.test.mjs",
    "test:classroom:multi-load": "vitest run tests/classroom-multi-load.test.mjs",
    "test:classroom:migration": "vitest run tests/classroom-migration-029.test.mjs",
    "test:classroom:backup-v12": "vitest run tests/classroom-backup-v12-postgres.test.mjs",
    "acceptance:classroom": "node tools/classroom-acceptance/run.mjs --local",
    "test:classroom:multi-browser": "node tests/classroom-multi.smoke.mjs",
    "test:classroom:browser": "node tests/classroom.smoke.mjs",
    "test:classroom:controls": "node tests/classroom-controls.smoke.mjs",
    "test:classroom:rate-limit": "node tests/classroom-ratelimit.smoke.mjs",
    "test:classroom:zoom-sdk": "node tests/classroom-zoom-sdk.smoke.mjs",
    "test:classroom:trial-server": "node tests/classroom-trial-server.smoke.mjs",
    "test:network-check": "node tests/zoom-network-check.smoke.mjs",
    "test:recording-pathway": "node --test \"tools/recording-pathway/test/*.test.mjs\"",
    "academy:fields": "node scripts/generate-academy-fields.mjs",
    "serve:legacy": "node scripts/prepare-public.mjs && node server.js",
    "db:audit": "node scripts/audit-database.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "site:snapshot-production": "node scripts/snapshot-production-site.mjs",
    "db:verify-backup-file": "node scripts/verify-backup-file.mjs",
    "db:verify-preserve-legacy": "node scripts/verify-preserve-legacy-content.mjs",
    "db:verify-production-preservation": "node scripts/verify-production-preservation.mjs",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:verify-rate-limit": "node scripts/verify-rate-limit.mjs",
    "db:migrate-content": "node scripts/migrate-content-overrides.mjs",
    "db:check-content": "npm run content:check && node scripts/check-content-db.mjs",
    "db:verify-backup": "node scripts/verify-backup.mjs",
    "storage:configure-site-media": "node scripts/configure-site-media-storage.mjs",
    "optimize:assets": "node scripts/optimize-static-images.mjs",
    "content:generate": "node scripts/generate-content-slots.mjs --write",
    "content:check": "node scripts/generate-content-slots.mjs",
    "translation:configure": "node scripts/configure-google-translation.mjs",
    "translation:backfill-team-local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/backfill-local-team-translations.mjs",
    "test:media-admin": "node tests/media-admin.smoke.mjs",
    "test:team-visibility": "node tests/team-visibility.smoke.mjs",
    "test:resources-admin": "node tests/resources-admin.smoke.mjs",
    "test:admin-sidebar": "node tests/admin-sidebar.smoke.mjs",
    "test:resource-model": "vitest run tests/resource-topic-model.test.mjs",
    "test:resource-schema": "vitest run tests/resource-topics-postgres.test.mjs",
    "test:resource-api-postgres": "vitest run tests/resource-topic-api-postgres.test.mjs",
    "test:resource-topics-admin": "node tests/resource-topics-admin.smoke.mjs",
    "test:resource-topics-public": "node tests/resource-topics-public.smoke.mjs",
    "test:calendar": "vitest run tests/home-calendar.test.mjs",
    "test:calendar:postgres": "vitest run tests/home-calendar-postgres.test.mjs",
    "test:calendar:browser": "node tests/home-calendar.smoke.mjs && node tests/home-calendar-views.smoke.mjs",
    "demo:classroom": "node tests/classroom.demo.mjs"
  },
  "dependencies": {
    "@google-cloud/translate": "^10.0.1",
    "@img/sharp-wasm32": "0.35.5",
    "@mediapipe/selfie_segmentation": "0.1.1675465747",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/oidc": "^3.8.5",
    "@zoom/videosdk": "2.6.0",
    "browser-image-compression": "2.0.2",
    "next": "16.4.1",
    "next-auth": "^5.0.0-beta.32",
    "opencc-js": "^1.4.2",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "0.35.5"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "0.35.5"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.4",
    "@img/sharp-linux-x64": "0.35.5"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
